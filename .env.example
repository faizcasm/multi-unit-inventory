# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/multi-unit-inventory?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_SECRET=your-super-secret-key-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Ricoz Inventory"
# API base URL used by clients calling the /api/v1 REST API. Usually empty
# (same-origin); set only if the API is served from a different origin.
NEXT_PUBLIC_API_URL=

# Cron
# Random 32+ char string. Required by /api/cron/* Bearer auth — Vercel crons
# send it automatically as `Authorization: Bearer $CRON_SECRET` when set.
CRON_SECRET=

# Auth
# Optional fallback URL used when generating digest emails (rarely needed).
AUTH_URL=

# SMTP (password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="Your App <your-email@gmail.com>"
